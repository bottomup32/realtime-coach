  "narrative": {
    "overview": "The implemented workspace is a compact, muted green and neutral operating surface. White panels, thin dividers and restrained controls support intermittent reading during a Korean meeting. This document records the existing implementation; it does not establish a new brand metaphor.\n\nThe current `coach-*` workspace extends the inherited identity through shadcn components. Legacy `meeting-*` styles remain for older surfaces and differ in spacing, type and radii; they are not the template for new workspace panels. Source of truth: `src/app/globals.css` and `src/components/ui/`.",
    "keyCharacteristics": [
      "Muted green actions and selected states.",
      "Compact labels with generous transcript line height.",
      "Thin borders and almost imperceptible panel shadows."
    ],
    "rules": [],
    "dos": [
      "Do reuse the existing shadcn primitives and workspace overrides.",
      "Do preserve visible labels, speaker identity, evidence links and keyboard focus.",
      "Do use thin dividers and pale fills to separate dense meeting information."
    ],
    "donts": [
      "Don't treat legacy meeting styles as current workspace tokens.",
      "Don't imply custom fonts, imagery or a complete dark workspace are implemented.",
      "Don't use color alone to identify recording, errors or the user's speaker."
    ]
  }
