# Configure actual runtime values securely; do not commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Choose models available to your Gemini account. No preview model is assumed valid.
GEMINI_LIVE_MODEL=
GEMINI_COACH_MODEL=
# Required for in-person multi-speaker diarization. Server-only key; never NEXT_PUBLIC.
DEEPGRAM_API_KEY=
# Optional, defaults to nova-3. Must support Korean and diarization for your account.
DEEPGRAM_MODEL=nova-3
